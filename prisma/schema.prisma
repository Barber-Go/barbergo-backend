// BarberGo v2 Schema — Enterprise Multi-Barbershop
// ─────────────────────────────────────────────────────────────────────────────
// Migration: enterprise_multi_barbershop_v1
// Changes: soft delete, multi-barbershop, tenant layer, enum status,
//          timezone/currency, barbershopId on bookings/expenses/ledger,
//          consistent timestamps on all models.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════════
// Enums
// ═══════════════════════════════════════════════════════════════════════════════

// Named "Role" in DB for backward compat; conceptually UserRole
enum Role {
  CLIENT
  BARBER              // Legacy — kept for existing rows
  BARBER_INDEPENDENT
  BARBER_EMPLOYEE
  BARBERSHOP_OWNER
  ADMIN
}

enum BarberEmploymentType {
  INDEPENDENT
  EMPLOYEE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CARD    // Legacy — kept for existing rows
  IN_APP
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  REVIEW_RECEIVED
  NEW_MESSAGE
  GENERAL
}

enum BlockType {
  LUNCH
  ERRAND
  PERSONAL
  VACATION
  DAY_OFF
  CUSTOM
}

enum MediaType {
  IMAGE
  VIDEO
}

enum LedgerEntryType {
  INCOME
  EXPENSE
  ADJUSTMENT
}

enum CommunityCategory {
  HAIRCUTS
  TRENDS
  COMPETITIONS
  PRODUCTS
  GENERAL
}

enum PublicEntityType {
  INDEPENDENT_BARBER
  BARBERSHOP
  BARBER_EMPLOYEE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum BarbershopStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum CancellerRole {
  CLIENT
  BARBER
  BARBERSHOP
  ADMIN
}

enum CancellationReason {
  CLIENT_CANT_ATTEND
  CLIENT_WRONG_TIME
  CLIENT_CHANGED_MIND
  CLIENT_EMERGENCY
  CLIENT_OTHER
  PROVIDER_ILLNESS
  PROVIDER_PERSONAL_ISSUE
  PROVIDER_LOCAL_ISSUE
  PROVIDER_EQUIPMENT
  PROVIDER_OVERBOOKING
  PROVIDER_OTHER
  ADMIN_POLICY
}

enum ProviderKind {
  BARBER_INDEPENDENT
  BARBERSHOP_OWNER
  BARBER_EMPLOYEE
}

enum SuspensionLevel {
  WARNING
  TEMPORARY_SUSPENSION
  UNDER_REVIEW
}

// ═══════════════════════════════════════════════════════════════════════════════
// Tenant (enterprise chain layer)
// ═══════════════════════════════════════════════════════════════════════════════

model Tenant {
  id        String       @id @default(cuid())
  name      String
  legalName String?
  country   String       @default("CL")
  currency  String       @default("CLP")
  status    TenantStatus @default(ACTIVE)
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  users       User[]
  barbershops BarbershopProfile[]

  @@map("tenants")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Core: User & Profiles
// ═══════════════════════════════════════════════════════════════════════════════

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  phone      String?  @unique
  password   String
  name       String
  avatarUrl  String?
  pushToken  String?
  role       Role     @default(CLIENT)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  // Tenant (optional — only for chain enterprises)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Profiles (one per role type)
  clientProfile      ClientProfile?
  barberProfile      BarberProfile?
  barbershopProfiles BarbershopProfile[]

  // Core relations (kept from v1)
  bookings      Booking[]      @relation("ClientBookings")
  reviews       Review[]       @relation("ClientReviews")
  notifications Notification[]

  // V2 relations
  settings             UserSettings?
  follows              Follow[]              @relation("Follower")
  pointsWallet         PointsWallet?
  communityMemberships CommunityMembership[]
  communityPosts       CommunityPost[]

  // Chat
  chatParticipants ChatParticipant[]
  chatMessages     ChatMessage[]
  aiFaceAnalyses   AiFaceAnalysis[]

  // Tax module
  taxModuleEnabled     Boolean   @default(false)
  taxModuleActivatedAt DateTime?
  taxDocuments         TaxDocument[]      @relation("UserTaxDocuments")

  // Invitations
  invitationsSent     BarberInvitation[] @relation("UserInvitations")
  invitationsAccepted BarberInvitation[] @relation("AcceptedInvitations")

  // Credits
  creditWallet        CreditWallet?
  creditTransactions  CreditTransaction[]
  adminCreditGrants   CreditTransaction[]  @relation("AdminCreditGrants")

  // Tips
  tipsGiven     Tip[] @relation("ClientTips")
  tipsReceived  Tip[] @relation("BarberTips")

  // Reports
  reports       Report[] @relation("ReporterReports")

  @@index([tenantId])
  @@map("users")
}

model ClientProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  preferredRadius Float     @default(10)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model BarberProfile {
  id               String               @id @default(cuid())
  userId           String               @unique
  bio              String?
  lat              Float?
  lng              Float?
  rating           Float                @default(0)
  totalReviews     Int                  @default(0)
  isActive         Boolean              @default(true)
  commissionRate   Float                @default(0.15)
  employmentType   BarberEmploymentType @default(INDEPENDENT)
  barbershopId     String?
  rutTributario    String?
  tipoClaveSii     String?              // "tributaria" | "clave_unica"
  claveTributaria  String?              // AES-256-GCM encrypted

  // Cancellation metrics
  cancellationRate     Float?           @default(0)
  cancellationCount30d Int              @default(0)
  bookingsCount30d     Int              @default(0)
  isCurrentlySuspended Boolean          @default(false)
  suspensionLevel      SuspensionLevel?
  suspensionExpiresAt  DateTime?

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop       BarbershopProfile?          @relation("BarbershopBarbers", fields: [barbershopId], references: [id])
  services         ServiceItem[]
  bookings         Booking[]                   @relation("BarberBookings")
  reviews          Review[]                    @relation("BarberReviews")
  earnings         Earning[]
  availabilities   WeeklyAvailability[]
  blocks           AvailabilityBlock[]
  portfolio        BarberPortfolioItem[]
  staffMemberships BarbershopStaffMembership[]
  expenses         Expense[]
  ledgerEntries    DailyLedgerEntry[]
  manualBookings   ManualBooking[]

  @@map("barbers")
}

model BarbershopProfile {
  id           String           @id @default(cuid())
  userId       String
  name         String
  description  String?
  address      String?
  lat          Float?
  lng          Float?
  phone        String?
  logoUrl      String?
  coverUrl     String?
  inviteCode   String?          @unique
  isActive     Boolean          @default(true)
  status       BarbershopStatus @default(DRAFT)
  timezone     String           @default("America/Santiago")
  currency     String           @default("CLP")
  country      String           @default("CL")
  scheduleJson String?

  // Cancellation metrics
  cancellationRate     Float?           @default(0)
  cancellationCount30d Int              @default(0)
  bookingsCount30d     Int              @default(0)
  isCurrentlySuspended Boolean          @default(false)
  suspensionLevel      SuspensionLevel?
  suspensionExpiresAt  DateTime?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  archivedAt   DateTime?

  // Tenant (optional — only for chain enterprises)
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  user    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff   BarbershopStaffMembership[]
  barbers BarberProfile[]             @relation("BarbershopBarbers")
  invitations BarberInvitation[]      @relation("BarbershopInvitations")
  taxProfile     TaxProfile?
  billingRecords BillingRecord[]

  // Enterprise relations
  bookings      Booking[]          @relation("BarbershopBookings")
  expenses      Expense[]          @relation("BarbershopExpenses")
  ledgerEntries DailyLedgerEntry[] @relation("BarbershopLedger")
  taxDocuments  TaxDocument[]      @relation("BarbershopTaxDocuments")

  @@index([userId])
  @@index([tenantId])
  @@map("barbershop_profiles")
}

model BarbershopStaffMembership {
  id              String   @id @default(cuid())
  barbershopId    String
  barberProfileId String
  role            String   @default("BARBER")
  joinedAt        DateTime @default(now())
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  barbershop        BarbershopProfile       @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  barberProfile     BarberProfile           @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  compensationRules StaffCompensationRule[]

  @@unique([barbershopId, barberProfileId])
  @@map("barbershop_staff_memberships")
}

model StaffCompensationRule {
  id           String   @id @default(cuid())
  membershipId String
  label        String
  percentage   Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  membership BarbershopStaffMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("staff_compensation_rules")
}

model BarberInvitation {
  id              String           @id @default(cuid())
  code            String           @unique
  barbershopId    String
  barbershop      BarbershopProfile @relation("BarbershopInvitations", fields: [barbershopId], references: [id])

  invitedByUserId String
  invitedBy       User             @relation("UserInvitations", fields: [invitedByUserId], references: [id])

  initialBarberPercent Int         @default(60)
  initialShopPercent   Int         @default(40)

  status          InvitationStatus @default(PENDING)
  email           String?
  acceptedByUserId String?
  acceptedBy      User?            @relation("AcceptedInvitations", fields: [acceptedByUserId], references: [id])
  acceptedAt      DateTime?

  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([code])
  @@index([barbershopId, status])
  @@map("barber_invitations")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Services & Availability
// ═══════════════════════════════════════════════════════════════════════════════

model ServiceItem {
  id          String    @id @default(cuid())
  barberId    String
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  durationMin Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  barber   BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("services")
}

model WeeklyAvailability {
  id        String   @id @default(cuid())
  barberId  String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, dayOfWeek])
  @@map("availabilities")
}

model AvailabilityBlock {
  id        String    @id @default(cuid())
  barberId  String
  type      BlockType
  label     String?
  startAt   DateTime
  endAt     DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("availability_blocks")
}

model ManualBooking {
  id            String    @id @default(cuid())
  barberId      String
  clientName    String?
  serviceName   String?
  date          DateTime
  startTime     String
  endTime       String
  note          String?
  paymentMethod String    @default("EXTERNAL")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  barber BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@map("manual_bookings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Bookings & Payments
// ═══════════════════════════════════════════════════════════════════════════════

model Booking {
  id            String        @id @default(cuid())
  clientId      String
  barberId      String
  serviceId     String
  scheduledAt   DateTime
  status        BookingStatus @default(PENDING)
  paymentMethod PaymentMethod
  currency      String        @default("CLP")

  // V1 financial columns (kept for backward compat)
  totalAmount Decimal @db.Decimal(10, 2)
  platformFee Decimal @db.Decimal(10, 2)
  barberNet   Decimal @db.Decimal(10, 2)

  // V2 financial snapshot
  grossAmount         Decimal @default(0) @db.Decimal(10, 2)
  platformFeePercent  Float   @default(0.15)
  distributableAmount Decimal @default(0) @db.Decimal(10, 2)
  barberAmount        Decimal @default(0) @db.Decimal(10, 2)
  shopAmount          Decimal @default(0) @db.Decimal(10, 2)
  netPayoutToBarber   Decimal @default(0) @db.Decimal(10, 2)
  serviceSnapshot     Json?

  // Boleta electrónica (SII)
  boletaFolio       String?
  boletaPdfUrl      String?
  boletaEstado      String?    // EMITIDA | ANULADA
  boletaEmitidaAt   DateTime?
  boletaAnuladaAt   DateTime?
  boletaAnulMotivo  String?
  boletaTipo        String?    // BHE | BVS_39 | FACTURA_33

  // Enterprise: direct barbershop reference
  barbershopId String?

  // Cancellation
  cancelledAt               DateTime?
  cancelledByUserId         String?
  cancelledByRole           CancellerRole?
  cancellationReason        CancellationReason?
  cancellationNotes         String?
  refundAmount              Int?
  refundTransactionId       String?
  compensationBonusAmount   Int?
  compensationBonusTxId     String?

  // Tips
  hasTip      Boolean  @default(false)
  tipAmount   Int?
  tipId       String?  @unique

  // Rating reminder
  rateReminderSkipCount    Int                @default(0)
  rateReminderLastShownAt  DateTime?
  rateReminderStatus       RateReminderStatus @default(PENDING)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client     User               @relation("ClientBookings", fields: [clientId], references: [id])
  barber     BarberProfile      @relation("BarberBookings", fields: [barberId], references: [id])
  service    ServiceItem        @relation(fields: [serviceId], references: [id])
  barbershop BarbershopProfile? @relation("BarbershopBookings", fields: [barbershopId], references: [id])
  payment            Payment?
  review             Review?
  earning            Earning?
  chatThread         ChatThread?
  creditTransactions CreditTransaction[]
  cancellationRecord CancellationRecord?
  tip                Tip?

  @@index([barbershopId, scheduledAt])
  @@index([barbershopId, status])
  @@index([cancelledByUserId, cancelledAt])
  @@map("bookings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Chat
// ═══════════════════════════════════════════════════════════════════════════════

model ChatThread {
  id         String   @id @default(cuid())
  bookingId  String?  @unique
  threadType String   @default("BOOKING_DIRECT") // BOOKING_DIRECT | BOOKING_BARBERSHOP | SUPPORT
  status     String   @default("OPEN")           // OPEN | CLOSED | ARCHIVED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  booking      Booking?          @relation(fields: [bookingId], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("chat_threads")
}

model ChatParticipant {
  id           String   @id @default(cuid())
  threadId     String
  userId       String
  roleInThread String    // CLIENT | BARBER | OWNER | SUPPORT
  lastReadAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id           String    @id @default(cuid())
  threadId     String
  senderId     String
  messageType  String    @default("TEXT") // TEXT | IMAGE | SYSTEM
  body         String
  metadataJson Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User       @relation(fields: [senderId], references: [id])

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String        @unique
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Reviews
// ═══════════════════════════════════════════════════════════════════════════════

model Review {
  id        String    @id @default(cuid())
  bookingId String    @unique
  clientId  String
  barberId  String
  rating       Int
  comment      String?
  compliments  String[]  @default([])
  issues       String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  deletedAt    DateTime?

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  client  User          @relation("ClientReviews", fields: [clientId], references: [id])
  barber  BarberProfile @relation("BarberReviews", fields: [barberId], references: [id])

  @@map("reviews")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Notifications
// ═══════════════════════════════════════════════════════════════════════════════

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Portfolio
// ═══════════════════════════════════════════════════════════════════════════════

model BarberPortfolioItem {
  id          String   @id @default(cuid())
  barberId    String
  title       String?
  description String?
  isFeatured  Boolean  @default(false)
  visibility  String   @default("PUBLIC") // PUBLIC | PRIVATE | UNLISTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  barber BarberProfile        @relation(fields: [barberId], references: [id], onDelete: Cascade)
  media  BarberPortfolioMedia[]

  @@map("barber_portfolio_items")
}

model BarberPortfolioMedia {
  id              String    @id @default(cuid())
  portfolioItemId String
  type            MediaType
  url             String
  thumbnailUrl    String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  portfolioItem BarberPortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)

  @@map("barber_portfolio_media")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Financial: Earnings, Expenses, Ledger
// ═══════════════════════════════════════════════════════════════════════════════

model Earning {
  id            String        @id @default(cuid())
  barberId      String
  bookingId     String        @unique
  date          DateTime
  grossAmount   Decimal       @db.Decimal(10, 2)
  platformFee   Decimal       @db.Decimal(10, 2)
  netAmount     Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt

  barber  BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("earnings")
}

model Expense {
  id          String    @id @default(cuid())
  barberId    String
  category    String
  description String?
  amount      Decimal   @db.Decimal(10, 2)
  date        DateTime
  receiptUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Enterprise: direct barbershop reference
  barbershopId String?

  barber     BarberProfile      @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barbershop BarbershopProfile? @relation("BarbershopExpenses", fields: [barbershopId], references: [id])

  @@index([barbershopId, date])
  @@map("expenses")
}

model DailyLedgerEntry {
  id        String          @id @default(cuid())
  barberId  String
  date      DateTime
  type      LedgerEntryType
  label     String
  amount    Decimal         @db.Decimal(10, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  deletedAt DateTime?

  // Enterprise: direct barbershop reference
  barbershopId String?

  barber     BarberProfile      @relation(fields: [barberId], references: [id], onDelete: Cascade)
  barbershop BarbershopProfile? @relation("BarbershopLedger", fields: [barbershopId], references: [id])

  @@index([barbershopId, date])
  @@map("daily_ledger_entries")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Social: Follows, Points
// ═══════════════════════════════════════════════════════════════════════════════

model Follow {
  id           String           @id @default(cuid())
  followerId   String
  followedType PublicEntityType
  followedId   String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedType, followedId])
  @@map("follows")
}

model PointsWallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  balance        Int      @default(0)
  lifetime       Int      @default(0)
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_wallets")
}

model RewardsCatalog {
  id          String   @id @default(cuid())
  title       String
  description String
  pointsCost  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("rewards_catalog")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Community
// ═══════════════════════════════════════════════════════════════════════════════

model Community {
  id          String            @id @default(cuid())
  name        String
  description String?
  category    CommunityCategory @default(GENERAL)
  coverUrl    String?
  isPublic    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  memberships CommunityMembership[]
  posts       CommunityPost[]
  tags        CommunityTopicTag[]

  @@map("communities")
}

model CommunityMembership {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  role        String   @default("MEMBER")
  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@map("community_memberships")
}

model CommunityPost {
  id          String   @id @default(cuid())
  communityId String
  authorId    String
  title       String?
  body        String
  imageUrl    String?
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("community_posts")
}

model CommunityTopicTag {
  id          String   @id @default(cuid())
  communityId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, name])
  @@map("community_topic_tags")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Settings
// ═══════════════════════════════════════════════════════════════════════════════

model UserSettings {
  id                 String  @id @default(cuid())
  userId             String  @unique
  pushNotifications  Boolean @default(true)
  emailNotifications Boolean @default(true)
  language           String  @default("es")
  currency           String  @default("CLP")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// AI Style
// ═══════════════════════════════════════════════════════════════════════════════

model AiFaceAnalysis {
  id              String   @id @default(cuid())
  userId          String
  sourceImageUrl  String
  faceShape       String   // oval | redondo | cuadrado | alargado | diamante | corazon
  confidence      Float
  attributesJson  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations AiHairstyleRecommendation[]

  @@map("ai_face_analyses")
}

model AiHairstyleRecommendation {
  id          String   @id @default(cuid())
  analysisId  String
  haircutName String
  rationale   String
  score       Float
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  analysis AiFaceAnalysis       @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  previews AiHairstylePreview[]

  @@map("ai_hairstyle_recommendations")
}

model AiHairstylePreview {
  id               String   @id @default(cuid())
  recommendationId String
  previewImageUrl  String?
  generationStatus String   @default("PENDING") // PENDING | COMPLETED | FAILED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  recommendation AiHairstyleRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@map("ai_hairstyle_previews")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Tax Compliance
// ═══════════════════════════════════════════════════════════════════════════════

model TaxProfile {
  id                   String    @id @default(cuid())
  barbershopId         String    @unique
  rut                  String
  razonSocial          String
  giro                 String?
  regimenTributario    String    @default("14D3") // 14A | 14D3 | 14D8
  vatAffectation       Boolean   @default(true)
  issuesDte            Boolean   @default(false)
  hasEmployees         Boolean   @default(false)
  withholdsHonorarios  Boolean   @default(false)
  monthlyRevenue       String?
  siiClaveType         String?
  siiClaveEncrypted    String?
  pfxCertificateBase64 String?   // certificado .pfx codificado en base64
  pfxPassword          String?   // contraseña del .pfx cifrada con AES-256-GCM
  siiResolucionNumero  Int?      // número de resolución SII emisor electrónico
  siiResolucionFecha   DateTime? // fecha de resolución SII
  comunaSii            String?   // comuna para documentos SII
  direccionSii         String?   // dirección para documentos SII
  actividadEconomica   Int?      // código actividad económica SII
  tipoContribuyente    String?   // PERSONA_NATURAL | SOCIEDAD_SPA | SOCIEDAD_EIRL
  dteEnabled           Boolean   @default(false)
  wizardCompletedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  barbershop  BarbershopProfile @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  obligations TaxObligation[]

  @@map("tax_profiles")
}

model TaxObligation {
  id            String    @id @default(cuid())
  taxProfileId  String
  type          String    // F29 | RCV | COTIZACIONES | RETENCIONES_BHE | F22
  name          String
  description   String?
  dueDate       DateTime
  period        String    // "2026-01" o "2026"
  status        String    @default("PENDING") // PENDING | COMPLETED | OVERDUE | SKIPPED
  completedAt   DateTime?
  siiFormUrl    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  taxProfile TaxProfile          @relation(fields: [taxProfileId], references: [id], onDelete: Cascade)
  logs       TaxDeclarationLog[]

  @@unique([taxProfileId, type, period])
  @@map("tax_obligations")
}

model TaxDeclarationLog {
  id           String   @id @default(cuid())
  obligationId String
  action       String   // MARKED_COMPLETED | MARKED_PENDING | AUTO_GENERATED | REMINDER_SENT
  performedBy  String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  obligation TaxObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  @@map("tax_declaration_logs")
}

model BillingRecord {
  id              String   @id @default(cuid())
  barbershopId    String
  period          String   // "2026-04" (YYYY-MM)
  apiCreditsUsed  Int      @default(0)
  bheEmitted      Int      @default(0)
  dteEmitted      Int      @default(0)
  totalCostClp    Int      @default(0)
  invoiceUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  barbershop BarbershopProfile @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([barbershopId, period])
  @@map("billing_records")
}

// ── Tax Documents (Boletas/Facturas) ──────────────────────────────────────

enum CreditTransactionType {
  REFUND
  ADMIN_GRANT
  BOOKING_PAYMENT
  EXPIRED
  ADJUSTMENT
  TIP_PAYMENT
}

enum TipStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum TipPayStatus {
  NONE
  PENDING
  SUCCESS
  FAILED
}

enum RateReminderStatus {
  PENDING
  RATED
  SKIPPED_MAX
}

enum ReportTargetType {
  BARBER
  BARBERSHOP
  BOOKING
}

enum ReportReason {
  NO_SHOW
  HYGIENE
  INCORRECT_CHARGE
  INAPPROPRIATE_ATTITUDE
  QUALITY
  OTHER
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum TaxDocumentType {
  BOLETA
  FACTURA
}

enum TaxDocStatus {
  SIMULATED
  PENDING
  EMITTED
  CANCELLED
  FAILED
}

model TaxDocument {
  id                 String           @id @default(cuid())
  userId             String
  barbershopId       String?

  documentType       TaxDocumentType
  amount             Int
  taxAmount          Int              @default(0)
  totalAmount        Int

  period             String           // YYYY-MM
  issuedAt           DateTime         @default(now())

  receptorRut        String?
  receptorName       String?
  receptorAddress    String?

  folio              Int?
  status             TaxDocStatus     @default(SIMULATED)
  pdfUrl             String?

  emitterRut         String
  emitterName        String

  cancelledAt        DateTime?
  cancellationReason String?
  deletedAt          DateTime?

  user               User                @relation("UserTaxDocuments", fields: [userId], references: [id])
  barbershop         BarbershopProfile?  @relation("BarbershopTaxDocuments", fields: [barbershopId], references: [id])

  @@index([userId, period])
  @@map("tax_documents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Credits Wallet
// ═══════════════════════════════════════════════════════════════════════════════

model CreditWallet {
  id          String   @id @default(cuid())
  userId      String   @unique
  balance     Int      @default(0)
  totalEarned Int      @default(0)
  totalSpent  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credit_wallets")
}

model CreditTransaction {
  id           String                @id @default(cuid())
  walletId     String
  userId       String
  type         CreditTransactionType
  amount       Int
  balanceAfter Int
  description  String
  metadata     Json?
  expiresAt    DateTime?
  isExpired    Boolean               @default(false)
  bookingId    String?
  grantedByAdminId String?
  createdAt    DateTime              @default(now())
  deletedAt    DateTime?

  wallet         CreditWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking        Booking?     @relation(fields: [bookingId], references: [id])
  grantedByAdmin User?        @relation("AdminCreditGrants", fields: [grantedByAdminId], references: [id])

  @@index([userId, createdAt])
  @@index([walletId])
  @@index([expiresAt, isExpired])
  @@map("credit_transactions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Cancellation System
// ═══════════════════════════════════════════════════════════════════════════════

model CancellationRecord {
  id                String             @id @default(cuid())
  providerUserId    String
  providerRole      ProviderKind
  barbershopId      String?
  bookingId         String             @unique
  cancelledAt       DateTime           @default(now())
  reason            CancellationReason
  notes             String?
  refundAmount      Int
  compensationBonus Int                @default(0)
  deletedAt         DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([providerUserId, cancelledAt])
  @@index([barbershopId, cancelledAt])
  @@map("cancellation_records")
}

model ProviderSuspension {
  id                String          @id @default(cuid())
  providerUserId    String?
  barbershopId      String?
  level             SuspensionLevel
  triggeredAt       DateTime        @default(now())
  triggerReason     String
  triggerMetrics    Json
  expiresAt         DateTime?
  resolvedAt        DateTime?
  resolvedByAdminId String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  @@index([providerUserId, isActive])
  @@index([barbershopId, isActive])
  @@map("provider_suspensions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Tips
// ═══════════════════════════════════════════════════════════════════════════════

model Tip {
  id              String       @id @default(cuid())
  bookingId       String       @unique
  clientId        String
  barberId        String
  amount          Int
  paidFromCredits Int          @default(0)
  paidFromCard    Int          @default(0)
  creditsTxId     String?
  webpayTxId      String?
  webpayStatus    TipPayStatus @default(NONE)
  status          TipStatus    @default(PENDING)
  createdAt       DateTime     @default(now())
  paidAt          DateTime?
  deletedAt       DateTime?

  booking Booking @relation(fields: [bookingId], references: [id])
  client  User    @relation("ClientTips", fields: [clientId], references: [id])
  barber  User    @relation("BarberTips", fields: [barberId], references: [id])

  @@index([clientId])
  @@index([barberId, paidAt])
  @@map("tips")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Reports
// ═══════════════════════════════════════════════════════════════════════════════

model Report {
  id              String           @id @default(cuid())
  reporterId      String
  targetType      ReportTargetType
  targetId        String
  bookingId       String?
  reason          ReportReason
  comment         String?
  status          ReportStatus     @default(OPEN)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?

  reporter User @relation("ReporterReports", fields: [reporterId], references: [id])

  @@index([targetId, targetType])
  @@index([status])
  @@map("reports")
}
