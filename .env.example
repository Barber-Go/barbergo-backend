# ═══════════════════════════════════════════════════════════════════════
# BarberGo Backend — Variables de Entorno
# ═══════════════════════════════════════════════════════════════════════
# Copiá este archivo a .env y completá los valores.
# NUNCA commitees el .env — debe estar ignorado (ya lo está).
# ═══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────
# CORE (obligatorias)
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/barbergo?schema=public"
PORT=3000
NODE_ENV=development   # development | production

# ──────────────────────────────────────────────
# AUTH (obligatorias)
# ──────────────────────────────────────────────
# Generar con: openssl rand -hex 64
JWT_SECRET="change-me-generate-with-openssl"
JWT_EXPIRES_IN="7d"

# ──────────────────────────────────────────────
# ENCRYPTION (obligatoria)
# ──────────────────────────────────────────────
# Generar con: openssl rand -hex 32 (AES-256)
# CRÍTICO: rotar esta key requiere re-cifrar credenciales SII persistidas.
ENCRYPTION_KEY="change-me-generate-with-openssl"

# ──────────────────────────────────────────────
# FRONTEND (obligatoria — redirects de pagos)
# ──────────────────────────────────────────────
FRONTEND_URL="https://app.barbergo.cl"

# ──────────────────────────────────────────────
# CLOUDINARY (obligatorias)
# ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ──────────────────────────────────────────────
# AI SERVICES (opcionales — AI Estilos)
# ──────────────────────────────────────────────
# sk-ant-... desde https://console.anthropic.com
ANTHROPIC_API_KEY=""
# AIza... desde https://aistudio.google.com
GOOGLE_AI_API_KEY=""

# ──────────────────────────────────────────────
# WEBPAY / TRANSBANK (obligatorias)
# ──────────────────────────────────────────────
TRANSBANK_ENV="integration"    # integration | production
TRANSBANK_COMMERCE_CODE=""
TRANSBANK_API_KEY=""

# ──────────────────────────────────────────────
# MERCADO PAGO (obligatorias)
# ──────────────────────────────────────────────
MP_ENV="sandbox"    # sandbox | production
# Debe coincidir con MP_ENV: TEST-... para sandbox, APP_USR-... para production
MP_ACCESS_TOKEN=""

# ──────────────────────────────────────────────
# SII / APIGATEWAY.CL (opcionales — módulo tributario)
# ──────────────────────────────────────────────
SII_API_BASE_URL="https://app.apigateway.cl/api/v2"
SII_API_TOKEN=""
SII_CLAVE=""
SII_EMISOR_RUT=""
SII_RUT=""

# ──────────────────────────────────────────────
# OBSERVABILIDAD (opcional — recomendado en producción)
# ──────────────────────────────────────────────
# DSN del proyecto "barbergo-backend" en sentry.io.
# Formato: https://<publicKey>@o<orgId>.ingest.<us|de>.sentry.io/<projectId>
# Si no está seteado, Sentry queda desactivado (fail-safe para dev local).
SENTRY_DSN=""
